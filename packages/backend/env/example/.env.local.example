DATABASE_URL=postgres://postgres:postgres@localhost:5432/spend_trend

# Failed Add Data Paste Reports (see docs/adr/0002).
# Vite bakes these into the bundle at build time, so on Render they must be set
# as environment variables before the build runs, not only at runtime.
#
# Linear personal API key. Reports are assigned to the key's owner.
# Without it, reporting returns 503 "Reporting isn't configured".
# LINEAR_API_KEY=
#
# Which environment the report came from: local, dev or production.
# local and dev prefix the Linear issue title with [local] / [dev]; anything else is production.
# Set APP_ENV=dev on the Render dev backend; NODE_ENV there isn't visible to the bundle.
APP_ENV=local
